# Local PostgreSQL (matches compose.yaml)
DATABASE_URL=postgresql://claimweave:claimweave@localhost:5432/claimweave?schema=public

# Better Auth local development
BETTER_AUTH_SECRET=replace-with-a-long-random-local-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Public app URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=

# Optional: Polsia/OpenAI-compatible model proxy.
# Model-backed extraction requires one of these. Never commit a real secret.
POLSIA_AI_BASE_URL=https://polsia.com/ai/openai/v1
# POLSIA_API_KEY=
# POLSIA_API_TOKEN=

# Optional owner bootstrap
# POLSIA_OWNER_EMAIL=
